# ── Public (exposed to the browser) ───────────────────────────────────────────
# Canonical site URL, used for metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Wordmark shown in the header and page titles.
NEXT_PUBLIC_BRAND_NAME=RAILROOM
# Optional: shows an Instagram link in the footer and Organization schema.
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Payments (Stripe Checkout) ────────────────────────────────────────────────
# When unset, orders are still created and stored with status "pending_payment"
# and customers are sent to the confirmation page without being charged.
# Use sk_test_... keys in development.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint POST /api/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
# Optional JSON webhooks (Slack/Discord/Zapier/your backend). When unset, events
# are appended to $DATA_DIR/<kind>-inbox.jsonl (contact, order, newsletter).
CONTACT_WEBHOOK_URL=
ORDER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for the file-backed order store and inboxes. Must be persistent and
# writable in production. Defaults to ./.data
DATA_DIR=
