# ── Public (exposed to the browser) ───────────────────────────────────────────
# Canonical site URL for metadata, sitemap and structured data. On Vercel the
# production domain is detected automatically, so this is optional there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Wordmark shown in the header and page titles.
NEXT_PUBLIC_BRAND_NAME=RAILROOM
# Optional: shows an Instagram link in the footer and Organization schema.
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Vercel Postgres, Supabase…). The Vercel/Neon
# integration sets DATABASE_URL (and POSTGRES_URL) automatically. Tables are created
# and the catalogue is seeded on first use. Without it, data is kept in JSON files
# under DATA_DIR (default ./.data) — fine locally, temporary on Vercel.
DATABASE_URL=
DATA_DIR=

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Password for the admin panel, at least 8 characters. The panel is disabled when unset.
ADMIN_PASSWORD=
# Optional: separate signing key for admin sessions (min 16 chars). Defaults to one
# derived from ADMIN_PASSWORD; changing either signs everyone out.
ADMIN_SESSION_SECRET=

# ── Payments ──────────────────────────────────────────────────────────────────
# LiqPay (LiqPay business account → Settings → API). Sandbox mode is ON unless
# LIQPAY_SANDBOX=0, so checkout uses LiqPay test cards and no money moves.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1
# Optional: Stripe Checkout instead of LiqPay (webhook: POST /api/webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Force a provider: liqpay | stripe | demo. Default: LiqPay if configured, then
# Stripe, otherwise the built-in demo payment page (simulated; collects no card data).
PAYMENT_PROVIDER=

# ── Notifications (optional) ──────────────────────────────────────────────────
# JSON webhooks (Slack/Discord/Zapier…) that receive a copy of each event.
# Orders, messages and signups are stored in the database regardless.
CONTACT_WEBHOOK_URL=
ORDER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
